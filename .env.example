POSTGRES_DB=tel_system
POSTGRES_USER=tel_user
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
SECRET_KEY=replace-with-strong-secret-key
API_KEY=replace-with-strong-external-api-key
INTERNAL_API_KEY=replace-with-strong-internal-api-key
CORS_ORIGINS=http://localhost:5000,http://localhost:8080
MAX_CONTENT_LENGTH=16777216
MAX_PDF_UPLOAD_SIZE=8388608
GEOCODER_TIMEOUT_SECONDS=2.0
